{
  "name": "pi-agent-recall",
  "version": "0.4.0-experimental.0",
  "private": true,
  "license": "MIT",
  "description": "Deterministic model attention policy: silent, reanchor, and bounded wake decisions",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "import": "./dist/pi/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "resources",
    "README.md",
    "docs"
  ],
  "pi": {
    "skills": ["./resources/skills"]
  },
  "scripts": {
    "test": "tsx --test \"tests/unit/*.test.ts\"",
    "ittest": "tsx tests/run-integration.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "prepack": "pnpm check"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
